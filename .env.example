# Copy this file to `.env` (the .env file is never uploaded to GitHub). Restart `npm run dev` after editing.

# The Web app address of the Google Apps Script that saves leads to the Google Sheet.
# In Apps Script: Deploy > New deployment > Web app > copy the URL that ends in /exec
VITE_LEADS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# The Web app address of the STAFF PORTAL script (scripts/staff-portal-google-apps-script.gs).
# Leave empty until the portal is set up; the Staff login page then explains it is not connected yet.
VITE_ADMIN_API_URL=

# If you publish with GitHub Pages instead, add the same value as a repository secret named VITE_LEADS_WEBHOOK_URL
# (Settings > Secrets and variables > Actions > New repository secret).
